{
  "name": "node-clean-architecture",
  "version": "1.0.0",
  "private": true,
  "description": "A Node.js and TypeScript service template following Clean Architecture",
  "keywords": [
    "clean-architecture",
    "express",
    "node",
    "template",
    "typescript"
  ],
  "license": "MIT",
  "author": "Oliver Tuck",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "db:start": "docker compose up --wait",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts | pino-pretty",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "node-pg-migrate",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "http-errors": "^2.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^18.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.12.1",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.2.0",
    "prettier": "3.9.9",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
